flowchart TD
    A["用户发帖"] --> B{"保存草稿?"}
    B -- 是 --> C["草稿：仅作者可见"]
    C --> D["提交审核"]
    B -- 否 --> D
    D --> MT["机器审核：标题、正文、图片"]
    MT -- 通过 --> G["已发布：公开可见"]
    MT -- 需复核 --> E["人工复核队列"]
    MT -- 违规 --> H["已驳回"]
    E --> F{"管理员裁决"}
    F -- 放行 --> G
    F -- 禁止 --> H
    H -.-> BAN["管理员可限时或永久封禁作者"]
    G --> ED["作者编辑"]
    ED --> HIS["追加新版本快照"]
    HIS --> MT
    G --> I["浏览、点赞、收藏"]
    G --> J["评论、标签、提及"]
    J --> MC["机器审核：先发后审"]
    MC -- 违规 --> SD["软删除或下架：保留数据与回复链"]
    SD -.-> FS["通知管理员"]
    FS -.-> RC["管理员可恢复误杀"]
    I --> K["站内通知"]
    J --> K
    D -.- L["封闭词表缺词：提交词条提议"]
    L --> M{"管理员审核"}
    M -- 通过 --> N["词条入库并回绑来源帖子"]
    M -- 驳回 --> O["记录驳回理由"]
